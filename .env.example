# Copy to .env and fill in. Nothing here is a real secret.

# --- App ---
ENVIRONMENT=development
# DEBUG=true makes Starlette return raw Python tracebacks in HTTP responses
# for unhandled exceptions, completely bypassing app/main.py's custom JSON
# error handler (this is Starlette's own behavior — debug mode is checked
# before any registered exception handler). Leave this false even in local
# dev; use the structured server logs (see app/core/logging.py) for
# tracebacks instead. Only flip to true for a short, deliberate debugging
# session, never leave it on.
DEBUG=false

# CORS_ALLOW_ORIGINS accepts a JSON array (pydantic-settings parses list
# fields from env vars this way). Defaults to just the local frontend dev
# server if unset. A real deployment should set this to the actual
# frontend origin(s) — never "*" combined with credentials (browsers
# reject that combination outright, and FastAPI's CORSMiddleware does too).
# CORS_ALLOW_ORIGINS=["https://app.example.com"]

# --- Database (required from Phase 3 onward) ---
# Used directly for local (non-Docker) dev. When running via `docker
# compose up` (Phase 16/ADR-019), docker-compose.yml overrides this with
# the postgres service's hostname instead - POSTGRES_USER/PASSWORD/DB below
# are what that override and the postgres service itself both read from.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_ai_platform

# --- Redis (required from Phase 4 onward) ---
REDIS_URL=redis://localhost:6379/0

# --- File storage (Phase 4) ---
STORAGE_ROOT=./data/uploads
MAX_UPLOAD_SIZE_MB=25

# --- Auth (required from Phase 3 onward — generate a real random value, this is not one) ---
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- LLM provider (Phase 7) ---
# One of: ollama | anthropic | openai | gemini (only ollama and anthropic are
# implemented so far — see ADR-010; openai/gemini raise NotImplementedError)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Only needed if LLM_PROVIDER selects it
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- RAG generation (Phase 7) ---
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_RESPONSE_TOKENS=1024

# --- Agent system (Phase 9) ---
# Kept deliberately small — the agent runs synchronously within one HTTP
# request up to these limits (ADR-012 decision 2), not as a background job.
AGENT_MAX_STEPS=8
AGENT_MAX_RUNTIME_SECONDS=90
AGENT_MAX_TOOL_CALLS=6
AGENT_PLANNER_MAX_TOKENS=1024

# --- Rate limiting (Phase 14, spec §39) ---
RATE_LIMITING_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_FAILED_LOGIN_ATTEMPTS=5
RATE_LIMIT_FAILED_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_UPLOAD_PER_HOUR=60
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AGENT_RUN_PER_HOUR=20

# --- Frontend ---
# No /api/v1 suffix here - every frontend hook call already includes that
# in its own path argument (see frontend/lib/api/client.ts), so including
# it here would duplicate to http://.../api/v1/api/v1/... and 404. Found
# while building Docker Compose (ADR-019) - this was never actually
# exercised in any earlier live test, since NEXT_PUBLIC_API_BASE_URL was
# never explicitly set before, always silently falling back to the code's
# own (correct) default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
